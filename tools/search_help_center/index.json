{
  "fingerprint": "05e0e1cfd873",
  "chunks": [
    {
      "chunk_id": "damaged-on-arrival/c1",
      "doc_id": "damaged-on-arrival",
      "title": "Damaged on arrival",
      "section": "If an item arrives damaged",
      "text": "If an item arrives damaged, the customer may choose a free replacement (a prepaid return label is provided for the damaged item) or a full refund."
    },
    {
      "chunk_id": "exchanges/c1",
      "doc_id": "exchanges",
      "title": "Exchanges",
      "section": "What can be exchanged",
      "text": "A customer may exchange an item for a different size or color of the same product within 30 days of delivery. The item must be unused and in its original packaging."
    },
    {
      "chunk_id": "exchanges/c2",
      "doc_id": "exchanges",
      "title": "Exchanges",
      "section": "How an exchange ships",
      "text": "The replacement ships when the carrier scans the returned item. A prepaid return label is provided."
    },
    {
      "chunk_id": "exchanges/c3",
      "doc_id": "exchanges",
      "title": "Exchanges",
      "section": "Price differences",
      "text": "If the replacement costs more, the customer pays the difference. If it costs less, the difference is refunded to the original payment method."
    },
    {
      "chunk_id": "late-or-lost-package/c1",
      "doc_id": "late-or-lost-package",
      "title": "Late or lost packages",
      "section": "When a package counts as late or lost",
      "text": "If a package is more than 7 days past its estimated delivery date, or its tracking has not moved for 5 days, the customer may choose a full refund or a free reshipment."
    },
    {
      "chunk_id": "late-or-lost-package/c2",
      "doc_id": "late-or-lost-package",
      "title": "Late or lost packages",
      "section": "What to say",
      "text": "Apologize for the delay. Do not promise a specific new delivery date."
    },
    {
      "chunk_id": "refund-timing/c1",
      "doc_id": "refund-timing",
      "title": "How long refunds take",
      "section": "When the refund lands",
      "text": "Approved refunds go back to the original payment method within 5 to 7 business days."
    },
    {
      "chunk_id": "refund-timing/c2",
      "doc_id": "refund-timing",
      "title": "How long refunds take",
      "section": "Confirmation",
      "text": "The customer gets an email confirmation when the refund is issued."
    },
    {
      "chunk_id": "warranty/c1",
      "doc_id": "warranty",
      "title": "Warranty",
      "section": "What the warranty covers",
      "text": "Every product includes a 1-year warranty against defects in materials and workmanship, starting on the delivery date."
    },
    {
      "chunk_id": "warranty/c2",
      "doc_id": "warranty",
      "title": "Warranty",
      "section": "If a covered defect appears",
      "text": "The customer may choose a free repair, a free replacement, or a full refund."
    },
    {
      "chunk_id": "warranty/c3",
      "doc_id": "warranty",
      "title": "Warranty",
      "section": "What the warranty does not cover",
      "text": "The warranty does not cover accidental damage, loss, or normal wear and tear."
    }
  ],
